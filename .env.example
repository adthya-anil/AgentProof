# Razorpay test mode credentials (never use live keys with AgentProof)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Payment adapter: "fake" runs fully offline, "razorpay" calls Razorpay test APIs.
PAYMENT_ADAPTER=fake

# Primary model for the buyer agent and the scenario generator.
# Adapter: "scripted" needs no key and keeps demos deterministic.
#          "openai" for any chat-completions endpoint (OpenAI, Azure, Groq, local).
#          "anthropic" for the Messages API.
LLM_ADAPTER=scripted
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Second model family, optional.
#
# The agents that will actually shop your store are not all one model, so naming
# a second deployment here makes every live-agent goal run twice — once per model
# — and the report attributes each finding to the model that produced it.
#
# ANTHROPIC_API_KEY falls back to LLM_API_KEY, because on Azure AI Foundry both
# families sit behind one resource and one key, and a second copy of a secret is
# just a second thing to forget to rotate.
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Fixed seed so preflight runs are reproducible for demos.
AGENTPROOF_SEED=1337

# Optional Postgres for persisted runs; or PGHOST/PGUSER/PGPASSWORD/PGDATABASE.
DATABASE_URL=
