# Razorpay test mode credentials (never use live keys with AgentProof)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Payment adapter: "fake" runs fully offline, "razorpay" calls Razorpay test APIs.
PAYMENT_ADAPTER=fake

# LLM used by the buyer agent and scenario generator.
# Adapter: "scripted" needs no key and keeps demos deterministic.
LLM_ADAPTER=scripted
LLM_API_KEY=
LLM_MODEL=

# Fixed seed so preflight runs are reproducible for demos.
AGENTPROOF_SEED=1337
