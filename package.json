{
  "name": "agentproof",
  "version": "0.1.0",
  "private": true,
  "description": "Preflight testing and runtime policy layer for agentic commerce.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "db:up": "bash scripts/dev-db.sh up",
    "db:down": "bash scripts/dev-db.sh down",
    "db:migrate": "tsx src/scripts/db-migrate.ts",
    "db:status": "tsx src/scripts/db-status.ts",
    "demo:happy": "tsx src/scripts/happy-path.ts",
    "demo:blocked": "tsx src/scripts/blocked-checkout.ts",
    "demo:defects": "tsx src/scripts/seeded-defects.ts",
    "demo:preflight": "tsx src/scripts/preflight.ts",
    "demo:concurrency": "tsx src/scripts/concurrency.ts",
    "demo:razorpay": "tsx src/scripts/razorpay-live.ts",
    "demo:merchant": "tsx src/scripts/second-merchant.ts",
    "demo:infer": "tsx src/scripts/infer-mapping.ts",
    "demo:merchant-preflight": "tsx src/scripts/merchant-preflight.ts"
  },
  "dependencies": {
    "next": "^15.5.24",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
