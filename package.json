{
  "name": "agentproof",
  "version": "0.1.0",
  "private": true,
  "description": "Preflight testing and runtime policy layer for agentic commerce.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
